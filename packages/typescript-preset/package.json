{
  "name": "@nx-devkit/typescript",
  "version": "0.0.1",
  "license": "MIT",
  "private": false,
  "type": "module",
  "description": "Preset Nx plugin that infers typecheck and vitest test targets from tsconfig.json and vitest.config.* without any project.json.",
  "main": "./src/plugin.ts",
  "module": "./src/plugin.ts",
  "types": "./src/plugin.ts",
  "exports": {
    ".": {
      "types": "./src/plugin.ts",
      "default": "./src/plugin.ts"
    },
    "./generators/init": {
      "types": "./dist/generators/init/generator.d.mts",
      "default": "./dist/generators/init/generator.mjs"
    }
  },
  "generators": "./generators.json",
  "files": [
    "dist",
    "generators.json",
    "src/generators/init/schema.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@nx/devkit": "^22.0.0 || ^23.0.0",
    "@biomejs/biome": "^2.0.0",
    "eslint": "^9.0.0",
    "oxlint": "^1.0.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@biomejs/biome": { "optional": true },
    "eslint": { "optional": true },
    "oxlint": { "optional": true },
    "tsdown": { "optional": true },
    "vitest": { "optional": true }
  },
  "devDependencies": {
    "@nx-devkit/internal": "workspace:*",
    "tsdown": "^0.22.3",
    "vitest": "^4.1.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nx-devkit/nx.ts",
    "directory": "packages/typescript-preset"
  }
}
